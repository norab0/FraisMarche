{
  "name": "fraismarche",
  "version": "1.0.0",
  "private": true,
  "description": "Gestion locale du stock pour FraisMarché",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/app.ts\" \"vite --host 0.0.0.0\"",
    "dev:server": "tsx watch server/app.ts",
    "test": "NODE_ENV=test vitest run",
    "build": "tsc -b && vite build",
    "start": "tsx server/app.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "type": "module"
}
